#include "coverage_mask_gpu.h"
static int coverage_program(NFPCSceneGPU*g){
 if(g->coverage_program)return 1;
 const char*v="#version 120\nvoid main(){gl_Position=vec4(gl_Vertex.x/120.0-1.0,1.0-gl_Vertex.y/80.0,0.0,1.0);}";
 const char*f="#version 120\nuniform vec2 viewport;uniform vec2 origin;uniform vec3 base;uniform vec3 dx;uniform vec3 dy;uniform vec3 inverseDepth;uniform vec4 bounds;uniform vec4 color;uniform int endpoint;void main(){vec2 p=vec2(gl_FragCoord.x*240.0/viewport.x,(viewport.y-gl_FragCoord.y)*160.0/viewport.y);vec2 delta=p-origin;vec3 stq=base+dx*delta.x+dy*delta.y;float iz=inverseDepth.x+inverseDepth.y*delta.x+inverseDepth.z*delta.y;if(stq.z<=0.0||iz<=0.0||iz>0.015625)discard;vec2 st=stq.xy/stq.z;if(endpoint!=0){int px=int(gl_FragCoord.x),py=int(gl_FragCoord.y),w=int(viewport.x),h=int(viewport.y);st=vec2(float(((px*2+1)*120)/w),float((((h-py)*2-1)*80)/h));}if(st.x<bounds.x||st.x>=bounds.y||st.y<bounds.z||st.y>=bounds.w)discard;gl_FragColor=color;}";
 GLuint a=shader(g,VERTEX_SHADER,v),b=shader(g,FRAGMENT_SHADER,f);if(!a||!b){if(a)g->delete_shader(a);if(b)g->delete_shader(b);return 0;}GLuint program=g->create_program();g->attach_shader(program,a);g->attach_shader(program,b);g->link_program(program);g->delete_shader(a);g->delete_shader(b);GLint ok=0;g->get_program(program,LINK_STATUS,&ok);if(!ok){g->program_log(program,sizeof(error_text),NULL,error_text);g->delete_program(program);return 0;}g->coverage_program=program;return 1;
}
int nf_pc_scene_gpu_render_coverage_mask(NFPCSceneGPU*g,const double*ring,unsigned n,const unsigned bounds[4],const unsigned char color[4],unsigned aw,unsigned ah,unsigned endpoint){
 if(!g||g->owner!=GetCurrentThreadId()||!g->target||n>6||(!ring&&n)||!bounds||!color||!aw||!ah||aw>g->width||ah>g->height||endpoint>1||bounds[0]>bounds[1]||bounds[1]>240||bounds[2]>bounds[3]||bounds[3]>160){error("Coverage mask input/target/thread");return 0;}
 if(n<3||bounds[0]==bounds[1]||bounds[2]==bounds[3])return 1;
 double left=240,right=0,top=160,bottom=0;for(unsigned i=0;i<n;i++){const double*p=ring+i*6;for(unsigned k=0;k<6;k++)if(!isfinite(p[k]))return 0;if(p[2]<64||p[5]<=0)return 0;if(p[0]<left)left=p[0];if(p[0]>right)right=p[0];if(p[1]<top)top=p[1];if(p[1]>bottom)bottom=p[1];}
 NFPCRecipeMesh*m=nf_pc_recipe_mesh_ring(ring,n,65536);if(!m)return 0;uint64_t mi[3];float p[11];if(!nf_pc_recipe_mesh_info(m,mi)||!mi[1]){nf_pc_recipe_mesh_free(m);return 1;}if(!nf_pc_recipe_mesh_plane(m,0,p)){nf_pc_recipe_mesh_free(m);return 0;}nf_pc_recipe_mesh_free(m);
 double best=0;unsigned ids[3]={0};for(unsigned i=0;i<n;i++)for(unsigned j=i+1;j<n;j++)for(unsigned k=j+1;k<n;k++){double det=(ring[j*6]-ring[i*6])*(ring[k*6+1]-ring[i*6+1])-(ring[j*6+1]-ring[i*6+1])*(ring[k*6]-ring[i*6]);if(fabs(det)>best){best=fabs(det);ids[0]=i;ids[1]=j;ids[2]=k;}}if(best<1e-15)return 1;
 const double*a=ring+ids[0]*6,*b=ring+ids[1]*6,*c=ring+ids[2]*6;double bx=b[0]-a[0],by=b[1]-a[1],cx=c[0]-a[0],cy=c[1]-a[1],det=bx*cy-by*cx,z=1/a[2],bz=1/b[2]-z,cz=1/c[2]-z,zx=(bz*cy-cz*by)/det,zy=(bx*cz-cx*bz)/det;float iz[3]={(float)(z+zx*(p[0]-a[0])+zy*(p[1]-a[1])),(float)zx,(float)zy};for(unsigned k=0;k<3;k++)if(!isfinite(iz[k]))return 0;
 /* Conservative bounding quad ensures fragment half-open bounds, not triangle
    edge tie rules, determine coverage. Near depth is tested in the shader. */
 left=fmax(0,left-240./aw);right=fmin(240,right+240./aw);top=fmax(0,top-160./ah);bottom=fmin(160,bottom+160./ah);if(left>=right||top>=bottom)return 1;
 HDC dc=wglGetCurrentDC();HGLRC old=wglGetCurrentContext();if(!wglMakeCurrent(g->dc,g->context))return 0;int ok=0;if(!coverage_program(g))goto done;g->bind(FRAMEBUFFER,g->fbo);glViewport(0,0,aw,ah);glDisable(GL_BLEND);glDisable(GL_DEPTH_TEST);glDisable(GL_CULL_FACE);glDisable(GL_DITHER);glDisable(GL_SCISSOR_TEST);glDisable(GL_ALPHA_TEST);glColorMask(GL_TRUE,GL_TRUE,GL_TRUE,GL_TRUE);g->use_program(g->coverage_program);g->uniform2f(g->uniform(g->coverage_program,"viewport"),(float)aw,(float)ah);g->uniform2f(g->uniform(g->coverage_program,"origin"),p[0],p[1]);g->uniform3fv(g->uniform(g->coverage_program,"base"),1,p+2);g->uniform3fv(g->uniform(g->coverage_program,"dx"),1,p+5);g->uniform3fv(g->uniform(g->coverage_program,"dy"),1,p+8);g->uniform3fv(g->uniform(g->coverage_program,"inverseDepth"),1,iz);g->uniform4f(g->uniform(g->coverage_program,"bounds"),(float)bounds[0],(float)bounds[1],(float)bounds[2],(float)bounds[3]);g->uniform4f(g->uniform(g->coverage_program,"color"),color[0]/255.f,color[1]/255.f,color[2]/255.f,color[3]/255.f);g->uniform1i(g->uniform(g->coverage_program,"endpoint"),(GLint)endpoint);glBegin(GL_QUADS);glVertex2d(left,top);glVertex2d(right,top);glVertex2d(right,bottom);glVertex2d(left,bottom);glEnd();ok=glGetError()==GL_NO_ERROR;
done:g->use_program(0);g->bind(FRAMEBUFFER,0);wglMakeCurrent(dc,old);return ok;
}
